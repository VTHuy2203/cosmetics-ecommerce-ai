FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app
COPY requirements-ai.txt ./
RUN pip install --no-cache-dir -r requirements-ai.txt

COPY TTTT/WebBanHangMyPham/src/ML/ ./

RUN useradd --create-home --uid 10001 aiuser \
    && mkdir -p /data/chroma \
    && chown -R aiuser:aiuser /app /data
USER aiuser

EXPOSE 8010
CMD ["uvicorn", "api_rag_ollama:app", "--host", "0.0.0.0", "--port", "8010", "--workers", "1", "--proxy-headers", "--no-server-header"]
